#!/usr/bin/env bash
# Eolas HRIS — memulihkan backup: eolas-restore /var/backups/eolas/daily/20261201-023000
# Database dan file diganti isi backup. Aplikasi berhenti sebentar selama pemulihan.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/../lib.sh"

src="${1:-}"
[ -n "$src" ] && [ -f "$src/database.sql.gz" ] || die "Pakai: eolas-restore <folder backup> (berisi database.sql.gz)"
( cd "$src" && sha256sum -c --quiet SHA256SUMS ) || die "Checksum backup tidak cocok"
if [ "${EOLAS_YES:-}" != 1 ]; then
    read -r -p "Data sekarang akan DIGANTI dengan backup $src. Lanjut? (ketik YA) " ok
    [ "$ok" = "YA" ] || die "Dibatalkan"
fi

say "Menghentikan aplikasi"
dc stop caddy scheduler queue app
dc up -d db
say "Memulihkan database"
# Emptied first: tables a newer version added do not stay behind.
dc exec -T db sh -c 'mysql -h127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD" -e "DROP DATABASE IF EXISTS \`$MYSQL_DATABASE\`; CREATE DATABASE \`$MYSQL_DATABASE\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"' 2>/dev/null
gunzip -c "$src/database.sql.gz" | dc exec -T db sh -c 'exec mysql -h127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD"' 2>/dev/null
say "Memulihkan file"
dc run --rm --no-deps -T --entrypoint sh app -c 'rm -rf /var/www/html/storage/app && tar -C /var/www/html/storage -xzf - && chown -R www-data:www-data /var/www/html/storage/app' < "$src/storage.tar.gz"
# The data was encrypted with the backup's APP_KEY (2FA secrets, sessions): that key comes back;
# the version installed stays (an older database is migrated forward when the app starts).
old_key=$(grep -E '^APP_KEY=' "$src/env" | cut -d= -f2-)
if [ -n "$old_key" ] && [ "$old_key" != "$(env_get APP_KEY)" ]; then
    cp "$EOLAS_DIR/.env" "$EOLAS_DIR/.env.before-restore"
    env_set APP_KEY "$old_key"
    warn "APP_KEY diambil dari backup (data terenkripsi memakainya). .env sebelumnya: .env.before-restore"
fi
dc up -d || true
wait_healthy 240 || die "Aplikasi tidak sehat setelah pemulihan: cek 'docker logs eolas-app'"
say "Pemulihan selesai dari $src"
